---
import type { BrandData } from "@/types/brand";
import Button from "../ui/Button.astro";
import IconSvg from "../IconSvg.astro";

interface Props {
  brandData: BrandData;
}
const { brandData } = Astro.props;
const firstServiceUrl = brandData.services[0].url.toLowerCase();

const { action_sel, site_actions } = brandData.main;

// "21 апреля"
function formatRuDate(date: Date = new Date()): string {
  return new Intl.DateTimeFormat("ru-RU", {
    day: "numeric",
    month: "long",
  }).format(date);
}

function replaceDatePlaceholder(text: string): string {
  return text.includes("{DATE}") ? text.replaceAll("{DATE}", formatRuDate()) : text;
}

// достаём число перед %
function parseDiscount(text: string): number | null {
  const match = text.match(/(\d+(?:[.,]\d+)?)\s*%/);
  return match ? parseFloat(match[1].replace(",", ".")) : null;
}

let chosenAction: (typeof site_actions)[number] | undefined;

if (action_sel === 1) {
  // случайная акция при каждом заходе на страницу
  chosenAction = site_actions?.[Math.floor(Math.random() * (site_actions?.length ?? 0))];
} else {
  // активная акция
  chosenAction = site_actions?.find((a) => a.is_active === 1);
}

const description = chosenAction ? replaceDatePlaceholder(chosenAction.description) : null;
const discount = description ? parseDiscount(description) : null;
---

{
  description && (
    <section class="bg-promo-surface overflow-clip" data-cmp="Promo">
      <div class="container relative">
        <div class="flex items-center lg:justify-center gap-7 pl-1 pr-3 lg:px-0 lg:gap-15 max-w-[747px] mx-auto">
          <div class="flex flex-col py-3 lg:py-4">
            <p class="text-promo-text-primary text-md font-bold">{description}</p>
          </div>

          {discount !== null && (
            <div class="w-[68px] h-[42px] flex items-center justify-center rotate-[-20deg] rounded-sm text-button-surface-accent text-xl font-bold bg-[hsla(0,0%,100%,1)] shadow-[0px_4px_24px_0px_hsla(0,0%,36%,0.1)]">
              -{discount}%
            </div>
          )}

          <div class="py-2 ml-auto lg:ml-0">
            <a href={`/${firstServiceUrl}`} class="flex items-center gap-2.5 text-accent font-bold hover:underline">
              <span class="hidden lg:block">в каталог услуг</span>
              <IconSvg name="arrow-right" />
            </a>
          </div>
        </div>
      </div>
    </section>
  )
}
