---
import type { BrandData } from "@/types/brand";
import { getDiscountedPrice, getDiscountPercent, hasDiscount } from "@/utils/price";
import Button from "../ui/Button.astro";

interface Props {
  brandData: BrandData;
}

const { brandData } = Astro.props;

const firstServiceUrl = brandData.services[0].url.toLowerCase();

function getMinPriceService(subServices: Array<{ price: string; unit: string; name: string }>) {
  return subServices.reduce((min, current) => (parseFloat(current.price) < parseFloat(min.price) ? current : min));
}

const discount = getDiscountPercent(brandData.main.adv_price_percent);
const showDiscount = hasDiscount(discount);

const hasOrder = brandData.services.some((s) => s.order !== undefined);

const sortedServices = (
  hasOrder
    ? brandData.services.sort((a, b) => (Number(a.order) || 0) - (Number(b.order) || 0))
    : brandData.services.map((service, index) => ({
        ...service,
        order: index < 3 ? index + 1 : null,
      }))
)
  .filter((service) => service.is_active === 1)
  .slice(0, 7);

function isFeatured(service: (typeof sortedServices)[0]): boolean {
  return (Number(service.order) || 0) > 0;
}

