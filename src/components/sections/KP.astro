---
import type { BrandData } from "@/types/brand";
import KpForm from "../blocks/KpForm.astro";

interface Props {
  brandData: BrandData;
}

const { brandData } = Astro.props;
---

<section id="kp" class="bg-kp-surface overflow-clip scroll-mt-[100px]" data-cmp="KP">
  <div class="container">
    <div class="grid grid-cols-1 lg:grid-cols-[860px_1fr] gap-3 lg:gap-20 isolate">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_365px] gap-4">
        <h2 class="max-w-[416px] py-5 lg:py-12.5 text-left typo-h3 text-kp-text *:text-kp-text-accent *:not-italic">
          Бесплатно <em>сделаем</em> коммерческое предложение <em>индивидуально под ваши потребности</em>
        </h2>

        <KpForm />
      </div>

      <div class="self-end origin-bottom lg:scale-130 pointer-events-none">
        <img class="" src="/images/kp-image.webp" alt="" />
      </div>
    </div>
  </div>
</section>
