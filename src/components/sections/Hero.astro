---
import Button from "@/components/ui/Button.astro";

import HeroFeatures from "../blocks/HeroFeatures.astro";

interface Props {
  brandData: any;
  type: "main" | "about";
}

const { brandData, type = "main" } = Astro.props;

const firstServiceUrl = brandData.services[0].url.toLowerCase();
---

{
  type == "main" && (
    <section
      class="hero grid grid-cols-[100%] min-h-[595px] bg-hero-main-surface text-hero-main-text overflow-clip isolate"
      data-cmp="Hero"
    >
      <div class="container h-full">
        <div class="_hero-inner relative grid grid-cols-1 lg:grid-cols-2 items-start lg:items-center h-full py-8">
          <div class="_hero-image order-last lg:order-1">
            <img class="" src="/images/hero-main.webp" alt="" fetchpriority="high" />
          </div>

          <div class="_hero-content flex flex-col gap-10">
            <h1 class="_hero-title typo-h1 text-left text-balance">Грузчики и разнорабочие в {brandData.main.city_rod}</h1>

            <HeroFeatures />

            <div class="_hero-actions flex flex-col lg:flex-row items-start lg:items-center gap-6 lg:gap-8">
              <div class="_hero-actions-items">
                <Button href="#contact" variant="accent" text="Получить КП" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

{
  type == "about" && (
    <section
      class="hero grid grid-cols-[100%] min-h-[670px] bg-hero-about-surface text-hero-about-text overflow-clip isolate"
      data-cmp="Hero"
    >
      <div class="container h-full">
        <div class="_hero-inner relative grid grid-cols-1 lg:grid-cols-2 items-start lg:items-center h-full">
          <div class="_hero-content flex flex-col gap-10 py-8">
            <h1 class="_hero-title typo-h1 text-left text-balance">
              Работаем
              <br />с 2010 года
            </h1>

            <HeroFeatures />

            <div class="_hero-actions flex items-center gap-8">
              <div class="_hero-actions-items">
                <Button href={`/${firstServiceUrl}`} variant="secondary" text="Наши услуги" />
              </div>
            </div>
          </div>

          <div class="_hero-image justify-self-center">
            <img src="/images/hero-about.webp" alt="" fetchpriority="high" />
          </div>
        </div>
      </div>
    </section>
  )
}
